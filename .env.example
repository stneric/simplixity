# Copy to .env and fill in the first section. Docker Compose passes every
# variable in this file to the app; a local `uv run python -m app` reads it too.

# ── required ────────────────────────────────────────────────────────
# Chat models and embeddings. Leave it empty only if you run local models
# (Ollama, LM Studio) exclusively; embeddings then fall back to keyword ranking.
OPENROUTER_API_KEY=

# SearXNG refuses to start without a secret. Generate one with:
#   openssl rand -hex 32
SEARXNG_SECRET=

# ── where it listens ────────────────────────────────────────────────
# Host port. The container always listens on 3000.
# SIMPLIXITY_PORT=3000
# 127.0.0.1 keeps the app off the network. Set 0.0.0.0 only on a network you
# trust, or put a reverse proxy with TLS in front (see deploy/traefik.yml).
# SIMPLIXITY_BIND=127.0.0.1
# The public hostname, used by deploy/traefik.yml and as SearXNG's base URL.
# SIMPLIXITY_DOMAIN=research.example.com

# Extra room a thinking model gets on top of the answer budget, since the
# provider's token ceiling covers reasoning and prose together. 0 turns it off.
# REASONING_MAX_TOKENS=1024

# Second remote provider. When set, Groq's chat models join the picker.
# GROQ_API_KEY=

# Local inference, discovered automatically when reachable. Inside Docker these
# default to the host (host.docker.internal).
# OLLAMA_BASE_URL=http://localhost:11434
# LMSTUDIO_BASE_URL=http://localhost:1234
# LOCAL_DISCOVERY=true

# ── research defaults (the composer overrides both per question) ───
# auto | quick | balanced | deep. "auto" judges how much research a question
# is worth: one search for a lookup, a full plan for a research question. The
# fixed presets are ceilings and are never widened.
# DEFAULT_DEPTH=auto

# Comma-separated corpora:
#   web        general search across several independent engines
#   scholar    PubMed, arXiv, Crossref, OpenAlex, Semantic Scholar
#   news       newswires and established newsrooms
#   docs       official documentation, standards, GitHub, Stack Overflow
#   reference  encyclopaedias and primary texts
# DEFAULT_SOURCE_LENSES=web

# "auto" lets SearXNG infer the query language, so a German question is not
# searched as English. A fixed code (en, de, …) pins it.
# SEARCH_LANGUAGE=auto

# The place a weather question means when it names none. The app never asks
# the browser for a location, so this is the only source of a default. Blank:
# such a question says so and searches.
# HOME_LOCATION=

# Raises r.jina.ai rate limits when reading pages. Works without at low volume.
# JINA_API_KEY=

# ── literature page (all optional) ──────────────────────────────────
# Without keys the page still searches OpenAlex, Semantic Scholar, Crossref and
# arXiv; IEEE papers then arrive through those, often without their abstract.
#
# IEEE Xplore, from developer.ieee.org. A new key answers "Developer Inactive"
# until IEEE activates it; the round report says so.
# IEEE_API_KEY=
# Keyless Semantic Scholar calls share one throttled pool. Free on request.
# SEMANTIC_SCHOLAR_API_KEY=
# OPENALEX_API_KEY=
# Contact address for the faster OpenAlex and Crossref "polite pool".
# SCHOLAR_MAILTO=

# ── operations ──────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# MAX_CONCURRENT_RUNS=8
# RATE_LIMIT_RUNS_PER_MINUTE=20

# ── running without Docker ──────────────────────────────────────────
# Inside Compose these are set by docker-compose.yml and the values here are
# ignored.
# REDIS_URL=redis://localhost:6379
# DATABASE_PATH=./data/simplixity.db
# SEARXNG_API_URL=http://localhost:8080
